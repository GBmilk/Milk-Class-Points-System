{
  "name": "milk-class-points",
  "productName": "牛奶智慧班级积分",
  "version": "1.0.1",
  "description": "牛奶智慧班级积分管理系统——纯本地离线运行的班级积分管理桌面应用",
  "author": "GB牛奶",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder --win",
    "icon": "node scripts/gen-icon.mjs",
    "postinstall": "electron-builder install-app-deps",
    "package:mirror": "npm run build && set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder --win"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.29.4",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.3.11"
  }
}
